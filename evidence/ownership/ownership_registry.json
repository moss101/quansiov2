{
  "registry_version": "1.1.0",
  "canonical_services": {
    "quansio-api": {
      "owns": [
        "Authenticated public commands",
        "session entry",
        "event projection",
        "upload initiation"
      ],
      "must_not_own": [
        "graph execution",
        "provider credential custody",
        "effect settlement",
        "machine actuation"
      ],
      "package": "quansio/api",
      "deployable": "services/quansio_api",
      "decision_id": "ADR-0002"
    },
    "quansio-control": {
      "owns": [
        "Tenant/identity/RBAC/policy/approval/registry/schedule/support configuration authority"
      ],
      "must_not_own": [
        "model fulfillment",
        "browser actuation",
        "connector actuation",
        "guest actuation"
      ],
      "package": "quansio/control",
      "deployable": "services/quansio_control",
      "decision_id": "ADR-0002"
    },
    "quansio-runtime": {
      "owns": [
        "Canonical WorkGraph/AgentGraph/StateGraph execution",
        "admission",
        "turns",
        "waits",
        "cancellation",
        "budgets",
        "recovery coordination"
      ],
      "must_not_own": [
        "direct provider credentials",
        "unmediated external effects"
      ],
      "package": "quansio/runtime",
      "deployable": "services/quansio_runtime",
      "decision_id": "ADR-0002"
    },
    "quansio-model-gateway": {
      "owns": [
        "All model fulfillment",
        "provider adapters",
        "routing",
        "streaming",
        "usage settlement",
        "model egress policy"
      ],
      "must_not_own": [
        "task truth",
        "user approval truth",
        "general connector authority"
      ],
      "package": "quansio/model_gateway",
      "deployable": "services/quansio_model_gateway",
      "decision_id": "ADR-0002"
    },
    "quansio-context": {
      "owns": [
        "Context Projection",
        "SearchProgram execution",
        "retrieval coordination",
        "evidence assembly",
        "Knowledge Fabric queries"
      ],
      "must_not_own": [
        "independent task scheduler",
        "effect path"
      ],
      "package": "quansio/context",
      "deployable": "services/quansio_context",
      "decision_id": "ADR-0002"
    },
    "quansio-indexer": {
      "owns": [
        "Ingestion",
        "chunking",
        "indexing",
        "freshness",
        "tombstones",
        "index provenance"
      ],
      "must_not_own": [
        "model orchestration",
        "business workflow authority"
      ],
      "package": "quansio/indexer",
      "deployable": "services/quansio_indexer",
      "decision_id": "ADR-0002"
    },
    "quansio-worker-gateway": {
      "owns": [
        "Authenticated worker/guest transport",
        "lease/generation validation",
        "ACK/redelivery",
        "cancellation relay"
      ],
      "must_not_own": [
        "tenant policy ownership",
        "model credentials"
      ],
      "package": "quansio/worker_gateway",
      "deployable": "services/quansio_worker_gateway",
      "decision_id": "ADR-0002"
    },
    "quansio-machine-control": {
      "owns": [
        "Execution-target inventory",
        "placement",
        "leases",
        "generations",
        "snapshots",
        "restore",
        "migration"
      ],
      "must_not_own": [
        "application task truth",
        "provider fulfillment"
      ],
      "package": "quansio/machine_control",
      "deployable": "services/quansio_machine_control",
      "decision_id": "ADR-0002"
    },
    "quansio-integration-broker": {
      "owns": [
        "Connector adapters",
        "credential handles",
        "typed external operations",
        "webhook ingress"
      ],
      "must_not_own": [
        "policy/effect bypass",
        "ambient tenant secret exposure"
      ],
      "package": "quansio/integration_broker",
      "deployable": "services/quansio_integration_broker",
      "decision_id": "ADR-0002"
    },
    "quansio-artifact": {
      "owns": [
        "Immutable artifacts/evidence",
        "digests",
        "scanning",
        "grants",
        "lifecycle"
      ],
      "must_not_own": [
        "task orchestration"
      ],
      "package": "quansio/artifact",
      "deployable": "services/quansio_artifact",
      "decision_id": "ADR-0002"
    },
    "quansio-notify": {
      "owns": [
        "Durable attention/notification delivery",
        "receipt tracking"
      ],
      "must_not_own": [
        "approval truth",
        "task state authority"
      ],
      "package": "quansio/notify",
      "deployable": "services/quansio_notify",
      "decision_id": "ADR-0002"
    },
    "qworkerd": {
      "owns": [
        "Guest actuation for assigned filesystem/terminal/browser/computer/process operations"
      ],
      "must_not_own": [
        "ambient cloud authority",
        "provider credentials",
        "tenant policy ownership"
      ],
      "package": "quansio/qworkerd",
      "deployable": "services/qworkerd",
      "decision_id": "ADR-0002"
    }
  },
  "supporting_owners": {
