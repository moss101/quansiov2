  "effect_actuators": [
    {
      "actuator": "quansio-model-gateway",
      "effect_class": "model_fulfillment",
      "description": "External provider model calls inside the gateway trust boundary"
    },
    {
      "actuator": "quansio-integration-broker",
      "effect_class": "connector_operation",
      "description": "Typed connector operations with scoped credential handles"
    },
    {
      "actuator": "quansio-integration-broker",
      "effect_class": "webhook_ingress",
      "description": "Authenticated idempotent webhook ingress"
    },
    {
      "actuator": "qworkerd",
      "effect_class": "guest_actuation",
      "description": "Filesystem/terminal/browser/computer/process actuation on assigned targets"
    },
    {
      "actuator": "quansio-machine-control",
      "effect_class": "target_lifecycle",
      "description": "Execution-target placement, snapshot, restore and migration actuation"
    }
  ]
