    "evidence": "Executed verification reports and implementation evidence records",
    "clients": "Desktop/web/mobile/CLI client applications (projections only)",
    "deploy": "Deployment topology, compose topology and CI definitions",
    "platform": "Shared infrastructure instances and the shared platform kernel hosting logical state areas (logical per-area ownership tracked by schema ownership registry)"
  },
