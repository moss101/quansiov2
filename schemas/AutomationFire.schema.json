{
  "$id": "quansio://schema/AutomationFire/9.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "authority_snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "automation_id": {
      "minLength": 1,
      "type": "string"
    },
    "fire_id": {
      "minLength": 1,
      "type": "string"
    },
    "logical_fire_key": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scheduled_for": {
      "format": "date-time",
      "type": "string"
    },
    "schema_revision": {
      "const": "9.0.0"
    },
    "state": {
      "enum": [
        "ADMITTED",
        "RUNNING",
        "COMPLETED",
        "SKIPPED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "tenant_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_revision",
    "fire_id",
    "automation_id",
    "tenant_id",
    "logical_fire_key",
    "scheduled_for",
    "attempt",
    "authority_snapshot_id",
    "state"
  ],
  "title": "AutomationFire",
  "type": "object"
}
